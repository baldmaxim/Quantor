{
  "components": {
    "schemas": {
      "ComponentHealth": {
        "properties": {
          "duration_ms": {
            "minimum": 0.0,
            "title": "Duration Ms",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status",
          "duration_ms"
        ],
        "title": "ComponentHealth",
        "type": "object"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "MetaResponse": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "features": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Features",
            "type": "object"
          },
          "schema_version": {
            "title": "Schema Version",
            "type": "integer"
          },
          "stage": {
            "title": "Stage",
            "type": "string"
          }
        },
        "required": [
          "api_version",
          "schema_version",
          "environment",
          "stage",
          "features"
        ],
        "title": "MetaResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "components": {
            "items": {
              "$ref": "#/components/schemas/ComponentHealth"
            },
            "title": "Components",
            "type": "array"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "components"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "API портала автоматизированного подсчёта строительных объёмов. Stage 1: проекты, импорт распознанных пакетов и просмотрщик документации. Расчёта объёмов и вызовов моделей на этом этапе нет.",
    "title": "Quantor API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/meta": {
      "get": {
        "operationId": "read_meta",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Версии и возможности API",
        "tags": [
          "meta"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "liveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    }
  }
}
