{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantor.local/schema/mep-evidence-graph/0.1.0",
  "title": "Quantor MEP EvidenceGraph 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "source",
    "system",
    "scale_status",
    "entities",
    "route_fragments",
    "evidence",
    "conflicts",
    "unresolved"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "graph_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object"
    },
    "system": {
      "type": "string",
      "minLength": 1
    },
    "scale_status": {
      "enum": [
        "observed",
        "inferred",
        "conflicting",
        "unresolved"
      ]
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "route_fragments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}