# --- Node ---
node_modules/
.pnpm-store/
*.log
npm-debug.log*
pnpm-debug.log*

# --- Next.js / build ---
.next/
out/
dist/
build/
*.tsbuildinfo

# --- Python ---
.venv/
.venv-*/
# Unsloth компилирует патчи в текущий каталог (vision/) при загрузке модели.
unsloth_compiled_cache/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Env / secrets ---
.env
.env.*

# --- Test artifacts ---
coverage/
playwright-report/
test-results/
.playwright/

# --- Fixtures: крупные пользовательские архивы не коммитим ---
# Правило заведено на каждый этап отдельно, а не шаблоном `_prompts/*/fixtures/**`:
# так добавление этапа требует осознанного решения, а не молча наследует запрет.
_prompts/stage1/fixtures/**
!_prompts/stage1/fixtures/**/
!_prompts/stage1/fixtures/README.md
!_prompts/stage1/fixtures/**/.gitkeep

_prompts/stage2a_measurement_core/fixtures/**
!_prompts/stage2a_measurement_core/fixtures/**/
!_prompts/stage2a_measurement_core/fixtures/README.md
!_prompts/stage2a_measurement_core/fixtures/**/.gitkeep

# Stage 2B: в пакете только синтетика — фрагменты реальных проектов PlanSwift сюда не кладутся.
_prompts/stage2b_ai_geometry_qwen/fixtures/**
!_prompts/stage2b_ai_geometry_qwen/fixtures/**/
!_prompts/stage2b_ai_geometry_qwen/fixtures/README.md
!_prompts/stage2b_ai_geometry_qwen/fixtures/**/.gitkeep

# Stage 2B: частные данные PlanSwift, растры, датасеты и веса в git не попадают никогда.
# Правила только защищают — пользовательские файлы не удаляются. Dataset root лучше держать
# вне репозитория (QUANTOR_DATASET_ROOT), но и случайно положенное сюда не уйдёт в коммит.
*.7z
*.pst2
*.tif
*.tiff
/datasets/
/dataset-root/
/private/
/PD RD/
/planswift*/
/vision/data/
/vision/runs/
/vision/weights/
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx
*.gguf

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Клиентские чертежи и архивы в корне рабочего дерева в git не попадают (Р-MEP-5)
/*.pdf
/*.zip

# Комплект SSH-доступа к ML-серверу с GPU: закрытый ключ, в git и образы не попадает нигде
ML-SSH-access.zip
ML-SSH-access/
id_ed25519_ml_peer*
ml_peer*

# Архивы ревью промтов: артефакт передачи владельцу, в git не попадает
/review/
# Вывод plangeom по чертежу заказчика и справка несвободного пакета — только локально
plangeom_example_*.json
plangeom_fields.txt
