{
  "$comment": [
    "Общие векторы преобразования координат: этот файл читают И тесты Python (apps/api),",
    "И тесты TypeScript (apps/web). Совпадение проверяется на точное равенство, без допуска:",
    "допуск скрыл бы расхождение реализаций — ровно то, ради чего векторы и заведены.",
    "",
    "Ожидаемые значения подобраны аналитически, а не сняты с реализации: страница 1000x1000",
    "и катеты 300/400 дают ровно 500, прямоугольник даёт произведение сторон. Тест, который",
    "сверяется с собственным выводом, доказывает только воспроизводимость, но не правильность.",
    "",
    "Числа IEEE-754 binary64: Python и JavaScript дают для них одинаковые биты (ADR-0017)."
  ],
  "version": 1,
  "pages": {
    "square": { "display_width_pt": 1000.0, "display_height_pt": 1000.0 },
    "portrait_a4": { "display_width_pt": 595.276, "display_height_pt": 841.89 },
    "landscape_a4": { "display_width_pt": 841.89, "display_height_pt": 595.276 },
    "a1_landscape": { "display_width_pt": 2384.0, "display_height_pt": 1684.0 },
    "fractional": { "display_width_pt": 123.4567, "display_height_pt": 76.5432 },
    "ratio_3_4": { "display_width_pt": 3000.0, "display_height_pt": 4000.0 }
  },
  "to_pdf": [
    {
      "name": "начало координат — левый верхний угол",
      "page": "portrait_a4",
      "point": [0.0, 0.0],
      "expected": [0.0, 0.0]
    },
    {
      "name": "правый нижний угол — полный размер страницы",
      "page": "portrait_a4",
      "point": [1.0, 1.0],
      "expected": [595.276, 841.89]
    },
    {
      "name": "центр квадратной страницы",
      "page": "square",
      "point": [0.5, 0.5],
      "expected": [500.0, 500.0]
    },
    {
      "name": "на альбомной странице стороны не переставляются повторно",
      "page": "landscape_a4",
      "point": [1.0, 1.0],
      "expected": [841.89, 595.276]
    },
    {
      "name": "дробные размеры страницы",
      "page": "fractional",
      "point": [1.0, 1.0],
      "expected": [123.4567, 76.5432]
    },
    {
      "name": "верхний правый угол: x на пределе, y ноль",
      "page": "a1_landscape",
      "point": [1.0, 0.0],
      "expected": [2384.0, 0.0]
    }
  ],
  "roundtrip": [
    { "page": "portrait_a4", "point": [0.0, 0.0] },
    { "page": "portrait_a4", "point": [1.0, 1.0] },
    { "page": "square", "point": [0.25, 0.75] },
    { "page": "a1_landscape", "point": [0.5, 0.5] },
    { "page": "landscape_a4", "point": [0.125, 0.875] }
  ],
  "length": [
    {
