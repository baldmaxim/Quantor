# syntax=docker/dockerfile:1.7
# Образ CAD-исполнителя PDF -> DXF (ADR-0036).
#
# Тот же код `apps/api` (образ quantor-api того же коммита) плюс отдельный интерпретатор движка
# с закреплёнными пакетами. PyMuPDF (AGPL-3.0), Shapely/GEOS и Pillow живут только здесь и
# только в закрытом пакете GHCR (ADR-0036 п. 3); в образ quantor-api они не попадают.
#
#   cp <CAD_engine>/<pins.engine.archive_path> deploy/cad-engine/engine.zip
#   docker buildx build -f deploy/Dockerfile.cad-worker \
#     --build-arg API_IMAGE=ghcr.io/baldmaxim/quantor-api:<sha> \
#     --build-arg ENGINE_ARCHIVE_SHA256=<pins.engine.archive_sha256> .
ARG API_IMAGE
FROM ${API_IMAGE}

ARG ENGINE_ARCHIVE_SHA256

USER root

ENV CAD_ENGINE_HOME=/opt/cad-engine

# Пакеты движка — в своём venv (Python 3.12), версии и хеши из lock-файла.
COPY tools/cad_engine/requirements.linux-cp312.lock.txt /tmp/cad-requirements.txt
RUN python -m venv ${CAD_ENGINE_HOME}/venv \
    && ${CAD_ENGINE_HOME}/venv/bin/pip install --no-cache-dir --disable-pip-version-check \
        --require-hashes --only-binary :all: -r /tmp/cad-requirements.txt \
    && rm /tmp/cad-requirements.txt

# Runner и pins лежат рядом: runner читает pins.json из своего каталога.
COPY tools/cad_engine/quantor_cad_runner.py tools/cad_engine/pins.json ${CAD_ENGINE_HOME}/runner/

# Генератор трасс механики (ADR-0036 п. 8, tools/cad_mep): запускается интерпретатором движка
# (`python -I`), зависимости - те же numpy/shapely/ezdxf/pymupdf из venv движка. Код лежит там,
# где API ищет параметры и версию (/app/tools/cad_mep), поэтому sha256 параметров у API и
# исполнителя один и тот же файл.
COPY tools/cad_mep /app/tools/cad_mep

# Архив движка кладёт в контекст сборки publish.yml (checkout приватного репозитория по
# закреплённому коммиту, deploy-key только на чтение); здесь — повторная сверка SHA256 с pins.json.
COPY deploy/cad-engine/engine.zip ${CAD_ENGINE_HOME}/engine.zip
RUN test -n "${ENGINE_ARCHIVE_SHA256}" \
    && echo "${ENGINE_ARCHIVE_SHA256}  ${CAD_ENGINE_HOME}/engine.zip" | sha256sum -c -

# Рабочие каталоги попыток: удаляются после каждого задания. Файлы движка — только на чтение.
RUN chmod -R a=rX ${CAD_ENGINE_HOME} /app/tools/cad_mep \
    && mkdir -p /var/tmp/quantor-cad \
    && chown quantor:quantor /var/tmp/quantor-cad \
    && chmod 700 /var/tmp/quantor-cad

ENV CAD_ENGINE_PYTHON=${CAD_ENGINE_HOME}/venv/bin/python \
    CAD_ENGINE_RUNNER=${CAD_ENGINE_HOME}/runner/quantor_cad_runner.py \
    CAD_ENGINE_ARCHIVE=${CAD_ENGINE_HOME}/engine.zip \
    CAD_MEP_RUNNER=/app/tools/cad_mep/run_mep.py \
    CAD_WORK_ROOT=/var/tmp/quantor-cad

USER quantor

# Одно задание за раз; исполнитель выходит с кодом != 0, если движок не прошёл проверку.
CMD ["python", "-m", "app.cad_worker"]
