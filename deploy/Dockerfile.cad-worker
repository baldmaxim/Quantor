# syntax=docker/dockerfile:1.7
# Образ CAD-исполнителя PDF -> DXF (ADR-0036).
#
# Тот же код `apps/api` (образ quantor-api того же коммита) плюс отдельный интерпретатор движка
# с закреплёнными пакетами. PyMuPDF (AGPL-3.0), Shapely/GEOS и Pillow живут только здесь и
# только в закрытом пакете GHCR (ADR-0036 п. 3); в образ quantor-api они не попадают.
# Код API кладётся ПОСЛЕДНИМ слоем: всё тяжёлое (SSH-клиент, venv движка и модели, архив и генераторы)
# лежит ниже и не пересобирается и не передаётся при каждой правке кода.
#
#   # <CAD_engine> - чистый checkout коммита pins.engine.repo_ref приватного репозитория движка
#   cp <CAD_engine>/<pins.engine.archive_path> deploy/cad-engine/engine.zip
#   mkdir -p deploy/cad-engine/generators
#   cp -r <CAD_engine>/generators/cad_mep <CAD_engine>/generators/cad_walls \
#     <CAD_engine>/generators/cad_eom <CAD_engine>/generators/cad_facades \
#     <CAD_engine>/generators/cad_model deploy/cad-engine/generators/
#   rm -rf deploy/cad-engine/generators/*/tests   # sha256 params сверяет publish.yml (jq по pins.json)
#   docker buildx build -f deploy/Dockerfile.cad-worker \
#     --build-arg API_IMAGE=ghcr.io/baldmaxim/quantor-api:<sha> \
#     --build-arg ENGINE_ARCHIVE_SHA256=<pins.engine.archive_sha256> .
ARG API_IMAGE
# База образа API (deploy/Dockerfile.api): venv ссылаются на её интерпретатор /usr/local/bin/python3.12.
ARG PYTHON_IMAGE=python:3.12-slim
# Основа cad-worker: пакеты API без кода. По умолчанию - сам образ API (как раньше: publish.yml
# передаёт только API_IMAGE); deploy/ship-local.sh передаёт образ стадии api-deps того же Dockerfile.api,
# тогда правка кода API не пересобирает SSH-клиент, venv и архив движка.
ARG API_DEPS_IMAGE=${API_IMAGE}
# Основа итоговой стадии: по умолчанию стадия cad-base ниже; ship-local передаёт готовый образ
# `quantor-cad-base:<хеш>` (SSH-клиент и venv), собранный отдельно и повторно используемый.
ARG CAD_BASE_IMAGE=cad-base

# Пакеты движка и модели здания — отдельной стадией, не от образа API. Они зависят только от
# lock-файлов, поэтому между выпусками берутся из кэша сборки и слой с ними совпадает байт в байт:
# правка кода API больше не переустанавливает их, и выкатка не передаёт их заново (ship-local.sh).
FROM ${PYTHON_IMAGE} AS cad-env

ENV CAD_ENGINE_HOME=/opt/cad-engine \
    CAD_MODEL_HOME=/opt/cad-model

# Пакеты движка — в своём venv (Python 3.12), версии и хеши из lock-файла.
COPY tools/cad_engine/requirements.linux-cp312.lock.txt /tmp/cad-requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m venv ${CAD_ENGINE_HOME}/venv \
    && ${CAD_ENGINE_HOME}/venv/bin/pip install --disable-pip-version-check \
        --require-hashes --only-binary :all: -r /tmp/cad-requirements.txt \
    && rm /tmp/cad-requirements.txt

# Модель здания из IFC (`cad_model`): ifcopenshell и trimesh - в отдельном venv со своим lock-файлом
# (tools/cad_model/), чтобы закреплённые пакеты движка и результаты остальных генераторов не менялись.
COPY tools/cad_model/requirements.linux-cp312.lock.txt /tmp/cad-model-requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m venv ${CAD_MODEL_HOME}/venv \
    && ${CAD_MODEL_HOME}/venv/bin/pip install --disable-pip-version-check \
        --require-hashes --only-binary :all: -r /tmp/cad-model-requirements.txt \
    && rm /tmp/cad-model-requirements.txt

# Только на чтение — здесь, а не в итоговой стадии: chmod там переписал бы все файлы venv новым
# слоем, и образ снова вёз бы их при каждом выпуске.
RUN chmod -R a=rX ${CAD_ENGINE_HOME}/venv ${CAD_MODEL_HOME}/venv

# Основа: пакеты API (без кода) + SSH-клиент + venv. Меняется только вместе с lock-файлами, Dockerfile
# и пакетами API; код API, архив и генераторы движка сюда не входят.
FROM ${API_DEPS_IMAGE} AS cad-base

USER root

# SSH-клиент: проверки обводки Codex и ИИ-петли (ADR-0055) ходят на kg_claude по SSH.
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-client \
    && rm -rf /var/lib/apt/lists/*

ENV CAD_ENGINE_HOME=/opt/cad-engine \
    CAD_MODEL_HOME=/opt/cad-model

# --link: слой собирается отдельно от нижних и не зависит от них (одно содержимое - один блоб).
COPY --link --from=cad-env /opt/cad-engine/venv ${CAD_ENGINE_HOME}/venv
COPY --link --from=cad-env /opt/cad-model/venv ${CAD_MODEL_HOME}/venv

# Код API того же коммита: берётся в самом конце, чтобы его правка задевала только верхний слой.
FROM ${API_IMAGE} AS api-code

FROM ${CAD_BASE_IMAGE} AS cad-worker

ARG ENGINE_ARCHIVE_SHA256

USER root

ENV CAD_ENGINE_HOME=/opt/cad-engine \
    CAD_MODEL_HOME=/opt/cad-model

# Runner и pins лежат рядом: runner читает pins.json из своего каталога.
COPY tools/cad_engine/quantor_cad_runner.py tools/cad_engine/pins.json ${CAD_ENGINE_HOME}/runner/

# Генераторы CAD из репозитория движка (закреплены в pins.json, раздел generators): `cad_mep` (трассы
# и зоны, ADR-0036 п. 8) и `cad_walls` (конструкции кладки и монолита, ADR-0038; 3D DXF, ADR-0039).
# Запускаются интерпретатором движка (`python -I`), зависимости - те же numpy/shapely/ezdxf/pymupdf
# из venv движка. Каталоги лежат рядом: `cad_walls/run_walls.py` подключает `../cad_mep` для разбора
# отметок этажа (cad_mep.elevations). Контекст (без tests/) кладёт publish.yml после сверки sha256
# параметров с pins.json; версию и sha256 параметров API берёт из pins.json, не из файлов.
COPY deploy/cad-engine/generators/cad_mep ${CAD_ENGINE_HOME}/generators/cad_mep
COPY deploy/cad-engine/generators/cad_walls ${CAD_ENGINE_HOME}/generators/cad_walls
# ЭОМ и СС этажа (`cad_eom`): модель листа берёт из `../cad_mep`, как `cad_walls`.
COPY deploy/cad-engine/generators/cad_eom ${CAD_ENGINE_HOME}/generators/cad_eom
# Виды фасадов АР (`cad_facades`, ADR-0048): самодостаточный генератор, читает векторы и текст PDF.
COPY deploy/cad-engine/generators/cad_facades ${CAD_ENGINE_HOME}/generators/cad_facades
# Модель здания из IFC (`cad_model`): запускается интерпретатором из CAD_MODEL_HOME, не движка.
COPY deploy/cad-engine/generators/cad_model ${CAD_ENGINE_HOME}/generators/cad_model

# Архив движка кладёт в контекст сборки publish.yml (checkout приватного репозитория по
# закреплённому коммиту, deploy-key только на чтение); здесь — повторная сверка SHA256 с pins.json.
COPY deploy/cad-engine/engine.zip ${CAD_ENGINE_HOME}/engine.zip
RUN test -n "${ENGINE_ARCHIVE_SHA256}" \
    && echo "${ENGINE_ARCHIVE_SHA256}  ${CAD_ENGINE_HOME}/engine.zip" | sha256sum -c -

# Рабочие каталоги попыток: удаляются после каждого задания. Файлы движка — только на чтение.
RUN chmod a=rX ${CAD_ENGINE_HOME} ${CAD_MODEL_HOME} \
    && chmod -R a=rX ${CAD_ENGINE_HOME}/runner ${CAD_ENGINE_HOME}/generators \
        ${CAD_ENGINE_HOME}/engine.zip \
    && mkdir -p /var/tmp/quantor-cad \
    && chown quantor:quantor /var/tmp/quantor-cad \
    && chmod 700 /var/tmp/quantor-cad

# Код API (/app: app, alembic, pins, deploy) - последним слоем. При сборке поверх самого образа API
# (publish.yml, без API_DEPS_IMAGE) это повтор тех же файлов поверх них.
COPY --link --from=api-code /app/ /app/

ENV CAD_ENGINE_PYTHON=${CAD_ENGINE_HOME}/venv/bin/python \
    CAD_ENGINE_RUNNER=${CAD_ENGINE_HOME}/runner/quantor_cad_runner.py \
    CAD_ENGINE_ARCHIVE=${CAD_ENGINE_HOME}/engine.zip \
    CAD_GENERATORS_ROOT=${CAD_ENGINE_HOME}/generators \
    CAD_MEP_RUNNER=${CAD_ENGINE_HOME}/generators/cad_mep/run_mep.py \
    CAD_MEP_PARAMS=${CAD_ENGINE_HOME}/generators/cad_mep/params/v1.json \
    CAD_WALLS_RUNNER=${CAD_ENGINE_HOME}/generators/cad_walls/run_walls.py \
    CAD_WALLS_PARAMS=${CAD_ENGINE_HOME}/generators/cad_walls/params/v1.json \
    CAD_EOM_RUNNER=${CAD_ENGINE_HOME}/generators/cad_eom/run_eom.py \
    CAD_EOM_PARAMS=${CAD_ENGINE_HOME}/generators/cad_eom/params/v1.json \
    CAD_FACADES_RUNNER=${CAD_ENGINE_HOME}/generators/cad_facades/run_facades.py \
    CAD_FACADES_PARAMS=${CAD_ENGINE_HOME}/generators/cad_facades/params/v1.json \
    CAD_MODEL_PYTHON=${CAD_MODEL_HOME}/venv/bin/python \
    CAD_MODEL_RUNNER=${CAD_ENGINE_HOME}/generators/cad_model/run_model.py \
    CAD_MODEL_PARAMS=${CAD_ENGINE_HOME}/generators/cad_model/params/v1.json \
    CAD_WORK_ROOT=/var/tmp/quantor-cad

USER quantor

# Одно задание за раз; исполнитель выходит с кодом != 0, если движок не прошёл проверку.
CMD ["python", "-m", "app.cad_worker"]
