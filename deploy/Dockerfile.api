# Образ API, воркера и разовых команд (миграции, бакет, администратор).
#
# Тот же образ — разные команды (ADR-0014): `uvicorn` для API, `python -m app.worker` для
# исполнителя заданий, `python -m alembic` и `python -m app.cli` для обслуживания.
# Собирается в CI; на сервере сборки нет — там два ядра и четыре гигабайта на весь стек.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # Арены glibc: без предела процесс Python в тесном контейнере распухает до высшей
    # отметки и не отдаёт память системе.
    MALLOC_ARENA_MAX=2 \
    # Пакет не устанавливается, а читается из исходников: `schema_version.py` и настройки
    # ищут `alembic.ini` и корень репозитория от расположения своего файла.
    PYTHONPATH=/app/apps/api

WORKDIR /app/apps/api

# Зависимости — отдельным слоем и ровно те, что закреплены в pyproject: код меняется
# каждым коммитом, зависимости — редко. Набор dev сюда не попадает.
COPY apps/api/pyproject.toml ./pyproject.toml
RUN python -c "import tomllib; print('\n'.join(tomllib.load(open('pyproject.toml', 'rb'))['project']['dependencies']))" > /tmp/requirements.txt \
    && pip install -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

COPY apps/api/alembic.ini ./alembic.ini
COPY apps/api/alembic ./alembic
COPY apps/api/app ./app

# Закрепление движка и генераторов CAD (ADR-0036, ADR-0038): API читает из раздела generators только
# версии генераторов и sha256 параметров (путь по умолчанию - /app/tools/cad_engine/pins.json).
# Сами генераторы (cad_mep, cad_walls) - в репозитории движка и в образе cad-worker.
COPY tools/cad_engine/pins.json /app/tools/cad_engine/pins.json

# Описание развёртывания едет вместе с кодом, которому соответствует: update.sh берёт
# docker-compose.yml из образа того же коммита, а не из копии, правленной руками.
COPY deploy/docker-compose.yml deploy/update.sh /app/deploy/

RUN useradd --system --uid 10001 --home-dir /app --shell /usr/sbin/nologin quantor
USER quantor

EXPOSE 8000

# Заголовки прокси принимаются от любого адреса: API опубликован только во внутренних
# сетях Docker, и перед ним всегда стоит nginx, который сам выставляет X-Forwarded-*.
# Число процессов — API_WORKERS (по умолчанию 2). Оболочка нужна, чтобы прочитать переменную;
# `exec` оставляет uvicorn первым процессом контейнера, и SIGTERM доходит до него напрямую.
CMD ["sh", "-c", "exec python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers \"${API_WORKERS:-2}\" --proxy-headers --forwarded-allow-ips '*' --no-server-header"]
