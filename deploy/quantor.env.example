# Переменные боевого стека Quantor. Копируется на сервер как /opt/portals/quantor/.env
# (chmod 600) и заполняется ВРУЧНУЮ на сервере. Секреты не попадают ни в репозиторий,
# ни в переписку. Сгенерировать значение: openssl rand -hex 24
#
# Тега выпуска здесь нет: его ведёт update.sh в файле RELEASE, скрипты .env не меняют.

# Публичные адреса. Должны совпадать с тем, что вшито в образы web/admin при сборке.
PUBLIC_ORIGIN=https://quantor.meridianai.ru
ADMIN_ORIGIN=https://admin.quantor.meridianai.ru
# Общий домен cookie: сеанс портала виден и контуру управления на поддомене.
AUTH_COOKIE_DOMAIN=quantor.meridianai.ru

# База.
POSTGRES_PASSWORD=

# Хранилище MinIO: логин и пароль администратора хранилища, их же использует API.
# Пароль не короче 8 символов (требование MinIO).
S3_ACCESS_KEY_ID=quantor
S3_SECRET_ACCESS_KEY=

# Необязательно.
LOG_LEVEL=INFO
WORKER_CONCURRENCY=1
# Ключ TenderHUB: без него интеграция выключена.
TENDERHUB_API_TOKEN=
# Переопределение флагов возможностей. calc.portal сюда НЕ добавлять.
FEATURE_FLAGS=
