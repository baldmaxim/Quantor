  "$id": "quantor.tender_calc.view.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Геометрия одного вида: надмножество `routes3d.v2` движка (портал рисует тем же кодом).",
  "properties": {
    "dxf_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dxf Sha256",
      "type": "string"
    },
    "elements": {
      "items": {
        "$ref": "#/$defs/CalcElement"
      },
      "maxItems": 100000,
      "title": "Elements",
      "type": "array"
    },
    "floors": {
      "items": {
        "type": "string"
      },
      "maxItems": 500,
      "title": "Floors",
      "type": "array"
    },
    "polylines": {
      "items": {
        "$ref": "#/$defs/CalcPolyline"
      },
      "maxItems": 100000,
      "title": "Polylines",
      "type": "array"
    },
    "schema": {
      "const": "quantor.tender_calc.view.v1",
      "title": "Schema",
      "type": "string"
    },
    "view_key": {
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F-]{27}:\\d{1,4}:\\d{1,3}$",
      "title": "View Key",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "view_key",
    "dxf_sha256",
    "floors",
    "polylines",
    "elements"
  ],
  "title": "CalcViewFile",
  "type": "object"
}
