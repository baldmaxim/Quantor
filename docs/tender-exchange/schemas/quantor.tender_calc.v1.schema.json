{
  "$defs": {
    "CalcBaseRef": {
      "additionalProperties": false,
      "properties": {
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "release_id": {
          "format": "uuid",
          "title": "Release Id",
          "type": "string"
        }
      },
      "required": [
        "release_id",
        "manifest_sha256"
      ],
      "title": "CalcBaseRef",
      "type": "object"
    },
    "CalcFit": {
      "additionalProperties": false,
      "properties": {
        "axes": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Axes",
          "type": "array"
        },
        "max_mm": {
          "minimum": 0,
          "title": "Max Mm",
          "type": "number"
        },
        "method": {
          "enum": [
            "axes_affine",
            "identity"
          ],
          "title": "Method",
          "type": "string"
        },
        "rms_mm": {
          "minimum": 0,
          "title": "Rms Mm",
          "type": "number"
        },
        "view_key": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F-]{27}:\\d{1,4}:\\d{1,3}$",
          "title": "View Key",
          "type": "string"
        }
      },
      "required": [
        "view_key",
        "method",
        "rms_mm",
        "max_mm"
      ],
      "title": "CalcFit",
      "type": "object"
    },
    "CalcProducer": {
      "additionalProperties": false,
      "properties": {
        "skill": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Skill",
          "type": "string"
        },
        "skill_ref": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Skill Ref",
          "type": "string"
        },
        "tool": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "skill",
        "skill_ref",
        "tool"
      ],
      "title": "CalcProducer",
      "type": "object"
    },
    "CalcRef": {
      "additionalProperties": false,
      "properties": {
        "discipline": {
          "enum": [
            "mech",
            "eom",
            "ss"
          ],
          "title": "Discipline",
          "type": "string"
        },
        "system": {
          "maxLength": 32,
          "minLength": 1,
          "title": "System",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "discipline",
        "system",
        "title"
      ],
      "title": "CalcRef",
      "type": "object"
    },
    "CalcVersionInfo": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "label": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "message": {
          "default": "",
          "maxLength": 4000,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "label",
        "author",
        "created_at"
      ],
      "title": "CalcVersionInfo",
      "type": "object"
    }
  },
  "$id": "quantor.tender_calc.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base": {
      "$ref": "#/$defs/CalcBaseRef"
    },
    "calc": {
      "$ref": "#/$defs/CalcRef"
    },
    "files": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Files",
      "type": "object"
    },
    "fit": {
      "items": {
        "$ref": "#/$defs/CalcFit"
      },
      "title": "Fit",
      "type": "array"
    },
    "producer": {
      "$ref": "#/$defs/CalcProducer"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "schema": {
      "const": "quantor.tender_calc.v1",
      "title": "Schema",
      "type": "string"
    },
    "version": {
      "$ref": "#/$defs/CalcVersionInfo"
    }
  },
  "required": [
    "schema",
    "project_id",
    "base",
    "calc",
    "version",
    "producer",
    "fit",
    "files"
  ],
  "title": "CalcManifest",
  "type": "object"
}
