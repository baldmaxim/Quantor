# Пример окружения Quantor. Скопируйте в .env и правьте под себя — .env в git не попадает.
# Все переменные необязательны: и docker compose, и приложения имеют dev-умолчания,
# совпадающие со значениями ниже. Реальные секреты сюда не вписывать.

# --- Окружение ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_HOST=localhost
# Порт на хосте. Если 5432 занят локально установленным PostgreSQL — поставьте 5433:
# контейнер останется на 5432 внутри, наружу выйдет на 5433, и API подключится по нему.
POSTGRES_PORT=5432
POSTGRES_DB=quantor
POSTGRES_USER=quantor
POSTGRES_PASSWORD=quantor_dev_password

# --- Объектное хранилище (MinIO локально, Yandex Object Storage в проде) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=quantor_dev
S3_SECRET_ACCESS_KEY=quantor_dev_secret
S3_BUCKET=quantor-dev
S3_USE_PATH_STYLE=true

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Через запятую. Для доступа с другой машины добавьте её адрес: http://192.168.1.50:3000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Web ---
# Адрес API из браузера. При тестировании с другого компьютера — IP хоста, а не localhost.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Вход в портал ---
# dev  — фиксированная личность без провайдера. Работает только при ENVIRONMENT=local|test:
#        при staging/production приложение откажется запускаться, а не откроется всем.
# oidc — настоящий провайдер (Keycloak, authentik, корпоративный вход).
AUTH_MODE=dev

# Домен cookie задаётся только в бою, чтобы admin.example.ru и api.example.ru получили общий
# сеанс. Локально оставить пустым — браузер отвергнет cookie с доменом localhost.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_TTL_SECONDS=43200

# Кому выдать права администратора платформы при первом входе — почты или субъекты
# через запятую. Иначе после установки некому раздать доступ.
AUTH_BOOTSTRAP_PLATFORM_ADMINS=

# Заполняется при AUTH_MODE=oidc. Адрес возврата провайдер должен знать как
# <API>/api/v1/auth/callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
OIDC_SCOPES=openid profile email

# Куда вернуть браузер после входа. Не берётся из запроса: иначе это открытая переадресация.
PORTAL_BASE_URL=http://localhost:3000

# --- TenderHUB ---
# Ключ доступа `thk_…` выпускается в TenderHUB: «Настройки → Доступ к API»,
# область `tenders:read`. Секрет показывается один раз.
# Реальное значение кладите в .env, а не сюда: этот файл в git.
# Портал ходит в TenderHUB сам — в браузер ключ не попадает (ADR-0011).
TENDERHUB_API_URL=https://tender.su10.ru
TENDERHUB_API_TOKEN=
